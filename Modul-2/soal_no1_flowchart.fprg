<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="coba"/>
        <attribute name="authors" value="Arthur"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-05 05:17:48 PM"/>
        <attribute name="created" value="QXJ0aHVyO0RFU0tUT1AtTVUySDNRRTsyMDI2LTEwLTA1OzAzOjU3OjMwIFBNOzI5NzY="/>
        <attribute name="edited" value="QXJ0aHVyO0RFU0tUT1AtTVUySDNRRTsyMDI2LTEwLTA1OzA1OjE3OjQ4IFBNOzc7MzA5Nw=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="kode, digit1, digit2, digit3, nilaiAwal, tahap1, nilaiAkhir" type="Integer" array="False" size=""/>
            <declare name="status, siklus" type="String" array="False" size=""/>
            <input variable="kode"/>
            <assign variable="digit1" expression="kode / 100"/>
            <assign variable="digit2" expression="(kode / 10) % 10"/>
            <assign variable="digit3" expression="kode % 10"/>
            <assign variable="nilaiAwal" expression="digit1 * digit3"/>
            <if expression="digit2 % 2 == 1">
                <then>
                    <assign variable="tahap1" expression="nilaiAwal + 25"/>
                </then>
                <else>
                    <assign variable="tahap1" expression="nilaiAwal - digit2"/>
                </else>
            </if>
            <if expression="tahap1 % 3 == 0">
                <then>
                    <assign variable="nilaiAkhir" expression="tahap1 / 3"/>
                </then>
                <else>
                    <assign variable="nilaiAkhir" expression="tahap1 * 2"/>
                </else>
            </if>
            <if expression="nilaiAkhir &gt; 50">
                <then>
                    <assign variable="status" expression="&quot;Kategori A&quot;"/>
                </then>
                <else>
                    <if expression="nilaiAkhir &gt; 20">
                        <then>
                            <assign variable="status" expression="&quot;Kategori B&quot;"/>
                        </then>
                        <else>
                            <assign variable="status" expression="&quot;Password Ditolak&quot;"/>
                        </else>
                    </if>
                </else>
            </if>
            <if expression="nilaiAkhir % 2 == 0">
                <then>
                    <assign variable="siklus" expression="&quot;Siklus Genap&quot;"/>
                </then>
                <else>
                    <assign variable="siklus" expression="&quot;Siklus Ganjil&quot;"/>
                </else>
            </if>
            <output expression="&quot;Digit pertama = &quot; &amp; digit1" newline="True"/>
            <output expression="&quot;Digit kedua = &quot; &amp; digit2" newline="True"/>
            <output expression="&quot;Digit ketiga = &quot; &amp; digit3" newline="True"/>
            <output expression="&quot;Nilai pelacak awal = &quot; &amp; ToString(nilaiAwal)" newline="True"/>
            <output expression="&quot;Nilai setelah tahap pertama = &quot; &amp; ToString(tahap1)" newline="True"/>
            <output expression="&quot;Nilai akhir = &quot; &amp; ToString(nilaiAkhir)" newline="True"/>
            <output expression="&quot;Status Password = &quot; &amp; status" newline="True"/>
            <output expression="&quot;Siklus = &quot; &amp; siklus" newline="True"/>
        </body>
    </function>
</flowgorithm>
